	"story.carbon_name": "Carbon copy",
	"story.carbon_body": "Your disposal order has a second sheet. The pressure marks under “authorised by” match the way you grip the trigger.",
	"story.handwriting_name": "Familiar correction",
	"story.handwriting_body": "A clerk crossed out “original”. Above it: “current copy”. The correction is in your handwriting, including the misspelling you always make.",
	"story.duplicate_name": "Two authorisations",
	"story.duplicate_body": "Both copies of the order carry the same signature. One authorises tomorrow’s disposal. The other confirms you already received the material credit yesterday.",
	"story.audit_name": "Audit exception",
	"story.audit_body": "The audit lists no supervisor. It lists a rotating post: the surviving copy signs for the next batch. You are the only one still on the payroll.",
	"story.tomorrow_name": "Tomorrow’s carbon",
	"story.tomorrow_body": "The blank order is dated tomorrow. Its signature appears only where your worn copies rubbed the page. The bureau never needed a separate hand.",
	"story.signature_name": "The signing machine",
	"story.signature_body": "Inside the Original is a loop of your recorded movements. The final gesture is your signature. Every escape attempt taught it to sign more accurately.",
	"story.repair_name": "Unauthorised maintenance",
	"story.repair_body": "You paid to repair a copy marked “cheaper to replace”. Someone added your expense to the order as an objection, then left the approval box blank.",
	"story.retire_name": "Voluntary signature",
	"story.retire_body": "You chose the copy and pressed the stamp. The receipt calls it voluntary. Its signature line now contains one more stroke of yours.",
	"story.exhausted_name": "Automatic approval",
	"story.exhausted_body": "You let the copy wear through. The system stamped “no objection received”. Waiting was counted as a signature too.",
